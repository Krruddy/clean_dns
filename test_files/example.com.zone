$TTL    3600
$ORIGIN example.com.

; -----------------------------------------------------------------------
; Start of Authority
; -----------------------------------------------------------------------
@       IN  SOA     ns1.example.com. hostmaster.example.com. (
                    2024060101  ; serial  (YYYYMMDDNN)
                    3600        ; refresh (1 hour)
                    1800        ; retry   (30 minutes)
                    604800      ; expire  (1 week)
                    86400 )     ; minimum (1 day)

; -----------------------------------------------------------------------
; Name servers
; -----------------------------------------------------------------------
@       IN  NS      ns1.example.com.
@       IN  NS      ns2.example.com.

; -----------------------------------------------------------------------
; Mail exchangers — intentionally out of priority order
; -----------------------------------------------------------------------
@       IN  MX      30  mail3.example.com.
@       IN  MX      10  mail1.example.com.
@       IN  MX      20  mail2.example.com.

; -----------------------------------------------------------------------
; TXT records
; -----------------------------------------------------------------------
@       IN  TXT     "v=spf1 mx a:mail1.example.com ~all"

; -----------------------------------------------------------------------
; A records — intentionally unsorted
; -----------------------------------------------------------------------
www         IN  A       192.168.1.10
mail3       IN  A       192.168.1.22
ns2         IN  A       192.168.1.2
ftp         IN  A       192.168.1.50
api         IN  A       192.168.1.40
app         IN  A       192.168.1.60
db          IN  A       192.168.1.30
mail1       IN  A       192.168.1.20
mail2       IN  A       192.168.1.21
ns1         IN  A       192.168.1.1
web         IN  A       192.168.1.10

; -----------------------------------------------------------------------
; AAAA records — intentionally unsorted
; -----------------------------------------------------------------------
www         IN  AAAA    2001:db8::10
ns1         IN  AAAA    2001:db8::1
mail1       IN  AAAA    2001:db8::20

; -----------------------------------------------------------------------
; CNAME records — intentionally unsorted
; -----------------------------------------------------------------------
webmail     IN  CNAME   mail1
smtp        IN  CNAME   mail1
pop         IN  CNAME   mail1
imap        IN  CNAME   mail1
